# ---------------------------------------------------------------------------
# WhatsRouter — variaveis de ambiente (opcionais: ha padroes para tudo)
# Copie para .env e ajuste. A maior parte da configuracao e feita pelo painel.
# ---------------------------------------------------------------------------

# Porta do servidor HTTP (API + painel)
PORT=3000

# Endereco de escuta: 0.0.0.0 (todas as interfaces), 127.0.0.1 (somente esta
# maquina) ou o IP da maquina na rede (ex.: 192.168.0.1). Tambem ajustavel
# pelo painel em Configuracoes > Rede e acesso.
HOST=0.0.0.0

# URL publica usada em avisos e referencias externas (opcional)
PUBLIC_URL=

# Caminho do banco SQLite e diretorio de dados (midia, sessoes do WhatsApp)
DATABASE_PATH=./data/whatsrouter.sqlite
DATA_DIR=./data

# Sessao da API (assine com um valor aleatorio longo)
SESSION_SECRET=troque-este-valor

# Credenciais iniciais do painel (usadas apenas na primeira inicializacao)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=whatsrouter

# Provedor de WhatsApp: baileys | webhook | mock
WHATSAPP_PROVIDER=baileys

# Nivel de log: trace | debug | info | warn | error
LOG_LEVEL=info

# Token compartilhado para o provedor por webhook (n8n) em POST /api/webhook/whatsapp
WEBHOOK_TOKEN=

# Opcional: chave para transcricao de audio via API compativel com OpenAI
# (tambem configuravel pelo painel)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Opcional: servico local de transcricao (nada sai da sua maquina).
# Suba com: bash scripts/install-transcription.sh
# No painel: Midia e transcricao > "Servico local (faster-whisper)"
# WHISPER_PORT=9000
# WHISPER_MODEL=small
